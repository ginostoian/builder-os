# Copy to .env.local. Never commit real values.

# ── Clerk (docs/auth.md) ──
# Development instance keys only (pk_test_ / sk_test_). Live keys belong in Vercel production only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# From Clerk → Webhooks → your endpoint. Only needed where Clerk can reach the app (deployed environments).
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# ── Database (docs/database.md) ──
# Runtime: a LOGIN role that is a member of builderos_app (no ownership, no BYPASSRLS).
# For Neon, use the pooled connection string. Production requires sslmode=require or verify-full.
DATABASE_URL=postgres://builderos_app_local:change-me@localhost:5432/builderos?sslmode=disable

# Migrations only (pnpm db:migrate / db:generate): the schema owner. Not available to the running app.
DATABASE_URL_OWNER=postgres://builderos_owner_local:change-me@localhost:5432/builderos?sslmode=disable

# Database tests (pnpm test:db): a superuser on a throwaway database whose name ends in _test.
TEST_DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/builderos_test
