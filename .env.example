# Copy to .env.local and replace each <password>. Never commit real values.

# ── Clerk (docs/auth.md) ──
# Development instance keys only (pk_test_ / sk_test_). Live keys belong in Vercel production only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# From Clerk → Webhooks → your endpoint. Only needed where Clerk can reach the app (deployed environments).
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# ── Database (docs/database.md) ──
# Runtime: a LOGIN role that is a member of builderos_app (no ownership, no BYPASSRLS).
# For Neon, use the pooled connection string. Production requires sslmode=require or verify-full.
DATABASE_URL=postgres://builderos_app_local:<password>@localhost:5432/builderos?sslmode=disable

# Migrations only (pnpm db:migrate / db:generate): the schema owner. Not available to the running app.
DATABASE_URL_OWNER=postgres://builderos_owner_local:<password>@localhost:5432/builderos?sslmode=disable

# Database tests (pnpm test:db): a superuser on a throwaway database whose name ends in _test.
TEST_DATABASE_URL_ADMIN=postgres://postgres:<password>@localhost:5432/builderos_test

# ── Sending quotes (all optional) ──
# Public origin for links in emails and "copy link". Defaults to the request's host, which is right on
# previews and locally; set it in production if you use a custom domain.
# APP_URL=https://builder-os-saas.vercel.app
# Email the client their portal link (Resend). Without these, the send dialog gives you the link to copy.
# RESEND_API_KEY=re_...
# EMAIL_FROM="Better Homes Studio <quotes@yourdomain.co.uk>"

# ── File storage: Bunny.net (optional) ──
# Storage zone + its password (FTP & API access), the region endpoint, and the pull zone in front of it.
# Without these, uploads are off and settings ask for a logo link instead.
# BUNNY_STORAGE_ZONE=builderos
# BUNNY_STORAGE_KEY=...
# BUNNY_STORAGE_HOST=uk.storage.bunnycdn.com
# BUNNY_CDN_URL=https://builderos.b-cdn.net
# Optional: the pull zone's token authentication key, for private files served as signed links.
# BUNNY_TOKEN_KEY=...
