# Copy to .env.local and replace each <password>. Never commit real values.

# ── Clerk (docs/auth.md) ──
# Development instance keys only (pk_test_ / sk_test_). Live keys belong in Vercel production only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# From Clerk → Webhooks → your endpoint. Only needed where Clerk can reach the app (deployed environments).
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# ── Database (docs/database.md) ──
# Runtime: a LOGIN role that is a member of builderos_app (no ownership, no BYPASSRLS).
# For Neon, use the pooled connection string. Production requires sslmode=require or verify-full.
DATABASE_URL=postgres://builderos_app_local:<password>@localhost:5432/builderos?sslmode=disable

# Migrations only (pnpm db:migrate / db:generate): the schema owner. Not available to the running app.
DATABASE_URL_OWNER=postgres://builderos_owner_local:<password>@localhost:5432/builderos?sslmode=disable

# Database tests (pnpm test:db): a superuser on a throwaway database whose name ends in _test.
TEST_DATABASE_URL_ADMIN=postgres://postgres:<password>@localhost:5432/builderos_test

# ── Sending quotes (all optional) ──
# Public origin for links in emails and "copy link". Defaults to the request's host, which is right on
# previews and locally; set it in production if you use a custom domain.
# APP_URL=https://builder-os-saas.vercel.app
# Email the client their portal link (Resend). Without these, the send dialog gives you the link to copy.
# RESEND_API_KEY=re_...
# EMAIL_FROM="Better Homes Studio <quotes@yourdomain.co.uk>"

# ── File storage: Bunny.net (optional) ──
# Storage zone + its password (FTP & API access), the region endpoint, and the pull zone in front of it.
# Without these, uploads are off and settings ask for a logo link instead.
# BUNNY_STORAGE_ZONE=builderos
# BUNNY_STORAGE_KEY=...
# BUNNY_STORAGE_HOST=uk.storage.bunnycdn.com
# BUNNY_CDN_URL=https://builderos.b-cdn.net
# Optional: the private pull zone's token authentication key, for photos, files and receipts as expiring links.
# BUNNY_TOKEN_KEY=...

# ── Reading receipts (optional) ──
# Fills in the expense form from a receipt photo or PDF, using Claude.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Payment reminders (optional) ──
# Vercel Cron calls /api/cron/reminders daily at 08:00 UTC with "Authorization: Bearer $CRON_SECRET".
# Without it the endpoint answers 503 and no reminders go out. Use a long random value (openssl rand -hex 32).
# CRON_SECRET=...

# ── Plans and online invoice payments: Stripe (optional; docs/integrations.md) ──
# Create products and prices with: pnpm stripe:setup
# STRIPE_SECRET_KEY=sk_test_...
# Signing secrets of the two webhook endpoints (your account; connected accounts), both /api/webhooks/stripe.
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# STRIPE_PORTAL_CONFIGURATION=bpc_...
# STRIPE_AUTOMATIC_TAX=1
# Emails of the website owner's team who can open the owner admin area at /admin.
# PLATFORM_ADMIN_EMAILS=you@example.com
# The admin area at /admin asks for a code from an authenticator app (set up on first visit); =1 skips that (development only).
# PLATFORM_ADMIN_ALLOW_NO_2FA=1

# ── Security (docs/integrations.md) ──
# Signs public form tokens and keys rate-limit counters. openssl rand -hex 32. Defaults to one derived from CLERK_SECRET_KEY.
# APP_SECRET=...

# ── Private files: expiring links (optional) ──
# A second Bunny pull zone with token authentication on, for photos, project files and receipts.
# BUNNY_PRIVATE_CDN_URL=https://builderos-private.b-cdn.net

# ── Error monitoring: Sentry (optional) ──
# NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# For readable stack traces (source map upload at build time):
# SENTRY_AUTH_TOKEN=...
# SENTRY_ORG=...
# SENTRY_PROJECT=...

# ── Uptime (optional) ──
# The daily job pings this when it finishes (a Better Stack / healthchecks.io heartbeat URL).
# CRON_HEARTBEAT_URL=https://...

# ── Search engines (docs/integrations.md) ──
# The live site's address, used in canonical links, the sitemap and structured data. Defaults to https://builder-os.co.uk.
# NEXT_PUBLIC_SITE_URL=https://builder-os.co.uk
# Google Search Console's HTML tag method (the content value only). Not needed if you verify by DNS.
# GOOGLE_SITE_VERIFICATION=...
