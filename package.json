{
  "name": "builder-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts",
    "clerk:roles": "tsx scripts/clerk-roles.ts",
    "stripe:setup": "tsx --env-file-if-exists=.env.local scripts/stripe-setup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@clerk/nextjs": "7.9.10",
    "@sentry/nextjs": "^11.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "geist": "^1.7.2",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "0.0.1",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@clerk/backend": "3.22.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
